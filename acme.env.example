# Cloudflare API token for Let's Encrypt (SAMBA_LETSENCRYPT=yes). Copy to
# acme.env and fill in; acme.env is not committed:
#   cp acme.env.example acme.env && chmod 600 acme.env
# See https://stefgo.github.io/samba-ad/tls/#lets-encrypt

# Token with the permissions Zone / DNS / Edit and Zone / Zone / Read,
# restricted to the zones of ACME_DOMAINS
CLOUDFLARE_DNS_API_TOKEN=

# Or: the path of a file in the container that holds the token (e.g. a
# Docker secret). Set one of the two, not both.
#CLOUDFLARE_DNS_API_TOKEN_FILE=/run/secrets/cloudflare_dns_api_token
