# Template: copy to .env and adjust. The .env file is not committed.

# Short name of the Docker host (becomes the NetBIOS name of the DC)
SAMBA_HOST_NAME=dc1

# IP address of the Docker host. BIND listens on this address, and it is the
# DNS server of the container during normal operation. Always the fixed
# address of the host, never a virtual one.
SAMBA_HOST_ADDRESS=192.168.1.10

# Optional: virtual addresses that move between the DCs (VRRP/keepalived,
# space-separated, without prefix length). BIND answers on them as well.
# They must not appear in any other setting of this file.
SAMBA_VIRTUAL_ADDRESS=

# Kerberos realm / DNS domain and NetBIOS domain name
SAMBA_REALM=EXAMPLE.LAN
WORKGROUP=EXAMPLE

# Existing DC of the domain (its fixed address). Only required for
# "./init.sh join"; used as join partner and as DNS server of the container
# during the join.
SAMBA_PEER_SERVER=192.168.1.11

# Addresses of this DC (space-separated, with prefix length). Samba registers
# them in DNS as addresses of the DC, so list fixed addresses only - no
# interface names such as eth0 and no virtual address.
SAMBA_INTERFACE=127.0.0.1/8 192.168.1.10/24

# yes: Samba (LDAP, Kerberos, SMB) listens on the addresses of SAMBA_INTERFACE
# only. no: it listens on every address of the host, which makes LDAP
# reachable through a virtual address. See "Virtual address" in README.md.
SAMBA_BIND_INTERFACES_ONLY=yes

# Optional: DNS forwarders for names outside the domain (space-separated)
SAMBA_DNS_FORWARDER=

# Log level of Samba (0-10). The SADM agent follows it: 0 = warn,
# 1-2 = info, 3-9 = debug, 10 = trace.
SAMBA_LOG_LEVEL=1

# Optional: SADM agent that reports local readings of this DC to a Samba AD
# Manager server. See "SADM agent" in README.md.
SADM_AGENT=no

# URL of the SADM server, e.g. https://sadm.example.net. The agent connects
# to it. Empty: the agent listens on SADM_CLIENT_PORT of the host, prints a
# setup PIN into the log and waits for the server to connect.
SADM_SERVER_URL=

# Token from "Add Agent" on the server, valid for one registration and one
# hour. Remove it again once the agent is registered.
SADM_REGISTRATION_TOKEN=

# true: accept a server certificate that does not validate
SADM_ALLOW_SELF_SIGNED=

# Port the agent listens on when it has no SADM_SERVER_URL
SADM_CLIENT_PORT=3021

# Time zone of the container
TZ=Europe/Berlin
