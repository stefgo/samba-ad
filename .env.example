# Settings of this domain controller. Copy to .env and adjust:
#   cp .env.example .env
# The name of the domain controller is the host name of this host.
# All settings: https://stefgo.github.io/samba-ad/configuration/

# --- Required ---------------------------------------------------------------

# Fixed IPv4 address of this host. Samba registers it in DNS as the address
# of this domain controller.
SAMBA_HOST_ADDRESS=192.168.1.10

# DNS name of the domain, which is also its Kerberos realm
SAMBA_REALM=EXAMPLE.LAN

# --- Only for "./init.sh join" ----------------------------------------------

# Fixed address of an existing domain controller of the domain
SAMBA_PEER_SERVER=

# --- Optional; empty means the default --------------------------------------

# NetBIOS name of the domain, at most 15 characters.
# Default: the first part of SAMBA_REALM, e.g. EXAMPLE
SAMBA_WORKGROUP=

# DNS servers that resolve names outside the domain (space-separated).
# Default: none, BIND asks the root servers of the internet.
SAMBA_DNS_FORWARDERS=

# Who may resolve names outside the domain through this DC: localhost,
# localnets (the networks of this host), addresses, networks such as
# 10.0.0.0/8, any or none. Add networks of clients behind a router.
# Default: localhost localnets
SAMBA_DNS_ALLOW_RECURSION=

# no: LDAP simple binds with a password are accepted without TLS (port 389).
# yes: only over LDAPS or StartTLS, Samba's own default.
# Default: no
SAMBA_LDAP_REQUIRE_STRONG_AUTH=

# Log level of Samba, 0 to 10, optionally with classes, e.g. "1 auth:3".
# Default: 1
SAMBA_LOG_LEVEL=

# Time zone of the logs. Default: UTC
TZ=Europe/Berlin

# Image tag, e.g. 1.2 to stay on a release line. Default: latest
SAMBA_IMAGE_TAG=

# --- Optional: addresses ----------------------------------------------------

# Addresses Samba uses and registers in DNS, with prefix length, e.g.
# "127.0.0.1/8 192.168.1.10/24". Fixed addresses only, no interface names.
# Default: 127.0.0.1/8 and SAMBA_HOST_ADDRESS with the prefix of its interface
SAMBA_INTERFACES=

# Virtual addresses (VRRP/keepalived), space-separated. Both lists are
# independent; one address may be in both.
# See https://stefgo.github.io/samba-ad/virtual-address/
# BIND answers DNS on these as well
SAMBA_DNS_VIRTUAL_ADDRESSES=
# haproxy serves LDAP and the Global Catalog on these
SAMBA_LDAP_VIRTUAL_ADDRESSES=

# --- Optional: Let's Encrypt certificate for LDAPS on the virtual address ---
# See https://stefgo.github.io/samba-ad/tls/ - the Cloudflare API token
# goes into acme.env (template: acme.env.example). haproxy serves the
# certificate on SAMBA_LDAP_VIRTUAL_ADDRESSES; Samba keeps its own for the
# host names.

# yes: obtain and renew the certificate. Default: no
SAMBA_LETSENCRYPT=

# Central names in the certificate (space-separated); the first is the
# common name
ACME_DOMAINS=

# Contact address of the Let's Encrypt account
ACME_EMAIL=

# ACME directory; for a test:
# https://acme-staging-v02.api.letsencrypt.org/directory
# Default: Let's Encrypt
ACME_SERVER=

# Key of the certificate, rsa2048 or ec256. Default: rsa2048
ACME_KEY_TYPE=

# Seconds to wait for the DNS record of the challenge. Default: 30
ACME_PROPAGATION_SECONDS=

# --- Optional: SADM agent ---------------------------------------------------
# See https://stefgo.github.io/samba-ad/sadm-agent/

# yes: run the agent. Default: no
SADM_AGENT=

# URL of the SADM server. Empty: the agent waits for the server to connect.
SADM_SERVER_URL=

# Token from "Add Agent", for the registration only; remove it afterwards
SADM_REGISTRATION_TOKEN=

# true: accept a server certificate that does not validate
SADM_ALLOW_SELF_SIGNED=
