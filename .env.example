# Vorlage: nach .env kopieren und anpassen. Die .env wird nicht eingecheckt.

# Kurzname des Docker-Hosts (wird zum NetBIOS-Namen des DC)
SAMBA_HOST_NAME=dc1

# IP-Adresse des Docker-Hosts. BIND lauscht auf dieser Adresse, und sie ist
# im normalen Betrieb der DNS-Server des Containers.
SAMBA_HOST_ADDRESS=192.168.1.10

# Kerberos-Realm / DNS-Domäne und NetBIOS-Domänenname
SAMBA_REALM=EXAMPLE.LAN
WORKGROUP=EXAMPLE

# Bestehender DC der Domäne. Nur für "./init.sh join" nötig; dient dabei als
# Join-Partner und als DNS-Server des Containers.
SAMBA_PEER_SERVER=192.168.1.11

# Schnittstellen, an die Samba bindet (leerzeichengetrennt, mit Präfixlänge)
SAMBA_INTERFACE=127.0.0.1/8 192.168.1.10/24

# Optional: DNS-Forwarder für Namen außerhalb der Domäne (leerzeichengetrennt)
SAMBA_DNS_FORWARDER=

# Paketquelle für Samba: trixie (4.22) oder trixie-backports (4.24)
SAMBA_SUITE=trixie-backports

# Zeitzone des Containers
TZ=Europe/Berlin
