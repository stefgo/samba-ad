{# Template of /etc/samba/smb.conf, written by entrypoint.sh at every start.
   The names are the settings of .env, as completed by load_settings in
   common.sh, and TLS_SOURCE (none or own) from entrypoint.sh. #}
# Written by the container at every start; changes here are lost.
# Own settings go into *.conf files below /etc/samba/conf.d (volume
# samba-dc-etc); they are included at the end of [global] and win.
# Everything not set here is Samba's default.

[global]
	netbios name = {{ NETBIOS_NAME }}
	realm = {{ REALM }}
	workgroup = {{ SAMBA_WORKGROUP }}
	server role = active directory domain controller
	# BIND answers DNS through Samba's DLZ module, Samba's own DNS is off.
	# Every other service is Samba's default, new ones included.
	server services = -dns
	# uidNumber and gidNumber come from the directory (provisioned with
	# --use-rfc2307)
	idmap_ldb:use rfc2307 = yes
	interfaces = {{ SAMBA_INTERFACES }}
	# Only the fixed addresses: haproxy serves LDAP and the Global Catalog on
	# the virtual addresses (haproxy.cfg.j2)
	bind interfaces only = yes
	log level = {{ SAMBA_LOG_LEVEL }}
	# no: LDAP simple binds are accepted without TLS (SAMBA_LDAP_REQUIRE_STRONG_AUTH)
	ldap server require strong auth = {{ SAMBA_LDAP_REQUIRE_STRONG_AUTH }}
	# Kerberos FAST is off, as in every earlier version of this image; the
	# reason is not recorded. "kdc enable fast = yes" in conf.d turns it on.
	kdc enable fast = no
{# The Let's Encrypt certificate is not Samba's: haproxy serves it on the
   virtual addresses #}
{% if TLS_SOURCE == "own" %}

	# Own certificate from tls/
	tls enabled = yes
	tls certfile = /etc/samba/tls/cert.pem
	tls keyfile = /etc/samba/tls/key.pem
{% if exists("/etc/samba/tls/ca.pem") %}
	tls cafile = /etc/samba/tls/ca.pem
{% else %}
	# Without this, Samba looks for its own generated CA and fails to start
	tls cafile =
{% endif %}
{% endif %}
{% for file in glob("/etc/samba/conf.d/*.conf") %}
{% if loop.first %}

	# Own settings
{% endif %}
	include = {{ file }}
{% endfor %}

[sysvol]
	path = /var/lib/samba/sysvol
	read only = No

[netlogon]
	path = /var/lib/samba/sysvol/{{ DNS_DOMAIN }}/scripts
	read only = No
