{# Template of /etc/bind/named.conf, written by entrypoint.sh at every start.
   The names are the settings of .env, as completed by load_settings in
   common.sh, and DLZ_MODULE from entrypoint.sh. #}
// Written by the container at every start; changes here are lost.

options {
    directory "/var/cache/bind";

    // 127.0.0.1 for local checks (e.g. keepalived), the host address and
    // SAMBA_DNS_VIRTUAL_ADDRESSES. An address that is not on an interface
    // yet is picked up as soon as it appears.
    listen-on {
        127.0.0.1;
        {{ SAMBA_HOST_ADDRESS }};
{% for address in SAMBA_DNS_VIRTUAL_ADDRESSES.split() %}
        {{ address }};
{% endfor %}
    };
    listen-on-v6 { none; };

    // Who may resolve names outside the AD zones (SAMBA_DNS_ALLOW_RECURSION).
    // The AD zones themselves answer everyone.
    allow-recursion {
{% for entry in SAMBA_DNS_ALLOW_RECURSION.split() %}
        {{ entry }};
{% endfor %}
    };
{% if SAMBA_DNS_FORWARDERS.split() %}

    // SAMBA_DNS_FORWARDERS; without them BIND asks the root servers
    forwarders {
{% for server in SAMBA_DNS_FORWARDERS.split() %}
        {{ server }};
{% endfor %}
    };
{% endif %}

    dnssec-validation auto;

    // Secure dynamic updates of the AD zones, signed with Kerberos
    tkey-gssapi-keytab "/var/lib/samba/bind-dns/dns.keytab";

    minimal-responses yes;
};

// The AD zones are kept in Samba's database
dlz "AD DNS Zone" {
    database "dlopen {{ DLZ_MODULE }}";
};
