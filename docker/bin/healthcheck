#!/bin/bash
# Health check of the container: supervisord reports BIND and Samba (and
# haproxy with virtual LDAP addresses) as running, and DNS and the main services of
# Samba answer on the host address. Docker shows the output with "docker
# inspect".

programs=(bind samba)
if [ -n "${SAMBA_LDAP_VIRTUAL_ADDRESSES:-}" ]; then
  programs+=(vip-proxy)
fi
status=$(supervisorctl status "${programs[@]}" 2>&1)
starting=$(awk '$2 != "RUNNING" {print $1 " is " $2}' <<< "$status")
if [ -n "$starting" ]; then
  echo "${starting//$'\n'/, }"
  exit 1
fi

failed=()
for port in 53 88 389 445; do
  if ! nc -z -w 3 "$SAMBA_HOST_ADDRESS" "$port" 2>/dev/null; then
    failed+=("$port")
  fi
done
if [ ${#failed[@]} -gt 0 ]; then
  echo "No answer on $SAMBA_HOST_ADDRESS port ${failed[*]} (53 DNS, 88 Kerberos, 389 LDAP, 445 SMB)"
  exit 1
fi
echo "BIND and Samba run; DNS, Kerberos, LDAP and SMB answer"
